
#LLM para preguntas clínicas puntuales (QA)
LLM_MODEL_AGENT=ministral-3:3b-instruct-2512-q8_0
  
# 🌐 Dirección del servidor Ollama donde están los modelos
LLM_BASE_URL=http://10.10.0.48:11434
  
# 🤖 Modelo de embeddings multilingüe (para ambos motores)
EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
EMBEDDING_DIM=384

# 🎮 Dispositivo para Embedder (cpu o cuda)
# ✅ CUDA: Consume ~500MB GPU, acelera ingesta 10-20x y consultas ~5x
EMBEDDER_DEVICE=cuda

# 🎮 Dispositivo para Reranker (cpu o cuda)
# ✅ CPU: Evita competencia con Ollama en GPU (RTX 5070 12GB)
# Reranker toma ~150-200ms en CPU vs ~50ms en GPU (diferencia imperceptible)
RERANKER_DEVICE=cpu
PYTORCH_CUDA_ALLOC_CONF=expandable_segments:True
# 📚 Modelo de reranking para Qdrant
RERANKER_MODEL_NAME=cross-encoder/mmarco-mMiniLMv2-L12-H384-v1 
# ⚙️ Otros ajustes del sistema
LLM_TEMPERATURE=0
QDRANT_URL=http://10.10.0.48:6333
  
# 🧠 Límites internos por ítem clínico (resumen por sección si querés después)
ITEM_TOKENS_MAX=2000
ITEM_MAX_CONCURRENT=3
  
# 🌍 IP del backend FastAPI (puede ser el mismo que el host local)
HOST=127.0.0.1
  
# 🏥 Backends adicionales
HCI_BACK=http://10.10.18.35:8888/
CAMAS_BACK=http://10.10.18.35:3333/
  
QDRANT_COLLECTION=hc_chat_db
MEMORY_BACKEND=redis
REDIS_URL=redis://10.10.0.48:6379/0
  
  
#Desarrollo verboso
HCI_DEBUG=1
DISABLE_ACCESS_LOG=0
LOG_LEVEL=INFO
RELOAD=0
  
#Producción (silencioso):
#HCI_DEBUG=0
#DISABLE_ACCESS_LOG=1
#LOG_LEVEL=ERROR
#RELOAD=0
###################################
  
  
